import kagglehub



import torch
import torch.nn as nn
import numpy as np

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print(f"Using device: {device}")

class GeometryNet(nn.Module):
    def __init__(self):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(2, 128), nn.GELU(),
            nn.Linear(128, 128), nn.GELU(),
            nn.Linear(128, 128), nn.GELU(),
            nn.Linear(128, 1)
        )

    def forward(self, x):
        return torch.sigmoid(self.net(x))


class FlowNet(nn.Module):
    def __init__(self):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(2, 192), nn.Tanh(),
            nn.Linear(192, 192), nn.Tanh(),
            nn.Linear(192, 192), nn.Tanh(),
            nn.Linear(192, 192), nn.Tanh(),
            nn.Linear(192, 3)
        )

    def forward(self, x):
        return self.net(x)

geo_net = GeometryNet().to(device)
flow_net = FlowNet().to(device)


def sample_points(N_domain=10000, N_boundary=1000):
    # Full domain [0, 3.0] x [0, 1.0]
    x = torch.rand(N_domain, 1) * 3.0
    y = torch.rand(N_domain, 1) * 1.0
    pts = torch.cat([x, y], dim=1).requires_grad_(True).to(device)
    
    # Inflow (x=0)
    y_in = torch.rand(N_boundary, 1)
    inflow = torch.cat([torch.zeros_like(y_in), y_in], dim=1).requires_grad_(True).to(device)
    
    # Outflow (x=3.0)
    y_out = torch.rand(N_boundary, 1)
    outflow = torch.cat([torch.full_like(y_out, 3.0), y_out], dim=1).requires_grad_(True).to(device)
    
    # Slip Walls (y=0 and y=1)
    x_wall = torch.rand(N_boundary * 2, 1) * 3.0
    y_wall = torch.cat([torch.zeros(N_boundary, 1), torch.ones(N_boundary, 1)])
    walls = torch.cat([x_wall, y_wall], dim=1).requires_grad_(True).to(device)
    
    return pts, inflow, outflow, walls


def compute_gradients(y, x):
    # Standard PyTorch autograd wrapper for PINNs
    grad = torch.autograd.grad(y, x, grad_outputs=torch.ones_like(y), create_graph=True)[0]
    return grad

def compute_physics_losses(flow_net, geo_net, pts, Re=30, lambda_max=100):
    uvp = flow_net(pts)
    u, v, p = uvp[:, 0:1], uvp[:, 1:2], uvp[:, 2:3]
    alpha = geo_net(pts)
    
    x, y = pts[:, 0:1], pts[:, 1:2]
    
    # First derivatives
    u_grads = compute_gradients(u, pts)
    u_x, u_y = u_grads[:, 0:1], u_grads[:, 1:2]
    
    v_grads = compute_gradients(v, pts)
    v_x, v_y = v_grads[:, 0:1], v_grads[:, 1:2]
    
    p_grads = compute_gradients(p, pts)
    p_x, p_y = p_grads[:, 0:1], p_grads[:, 1:2]
    
    # Second derivatives (Diffusion terms)
    u_xx = compute_gradients(u_x, pts)[:, 0:1]
    u_yy = compute_gradients(u_y, pts)[:, 1:2]
    v_xx = compute_gradients(v_x, pts)[:, 0:1]
    v_yy = compute_gradients(v_y, pts)[:, 1:2]
    
    # Brinkman Penalty Mask (Only active in [0.75, 1.75] x [0.25, 0.75])
    in_design_x = torch.logical_and(x >= 0.75, x <= 1.75)
    in_design_y = torch.logical_and(y >= 0.25, y <= 0.75)
    in_design = torch.logical_and(in_design_x, in_design_y).float()
    
    brinkman = lambda_max * (alpha * in_design)
    
    # Navier-Stokes + Brinkman Residuals
    res_u = (u * u_x + v * u_y) + p_x - (1/Re) * (u_xx + u_yy) + brinkman * u
    res_v = (u * v_x + v * v_y) + p_y - (1/Re) * (v_xx + v_yy) + brinkman * v
    res_mass = u_x + v_y
    
    L_PDE = torch.mean(res_u**2 + res_v**2 + res_mass**2)
    
    # Drag Surrogate (Total Energy Dissipation)
    dissipation = (1/Re) * (2*u_x**2 + 2*v_y**2 + (u_y + v_x)**2) + brinkman * (u**2 + v**2)
    L_Dissipation = torch.mean(dissipation)
    
    return L_PDE, L_Dissipation, alpha, in_design


import matplotlib.pyplot as plt
import numpy as np
import imageio
import os
import torch

os.makedirs("frames", exist_ok=True)
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

def save_frame(epoch, flow_net, geo_net):
    x = np.linspace(0, 3.0, 300)
    y = np.linspace(0, 1.0, 100)
    X, Y = np.meshgrid(x, y)
    
    pts_flat = np.hstack((X.flatten()[:, None], Y.flatten()[:, None]))
    pts_tensor = torch.tensor(pts_flat, dtype=torch.float32).to(device)
    
    with torch.no_grad():
        alpha_pred = geo_net(pts_tensor).cpu().numpy().reshape(100, 300)
        uvp_pred = flow_net(pts_tensor).cpu().numpy()
        u_pred, v_pred = uvp_pred[:, 0].reshape(100, 300), uvp_pred[:, 1].reshape(100, 300)
        vel_mag = np.sqrt(u_pred**2 + v_pred**2)

    fig, ax = plt.subplots(figsize=(10, 4))
    ax.contourf(X, Y, vel_mag, levels=50, cmap='GnBu', alpha=0.8)
    
    ax.contourf(X, Y, alpha_pred, levels=[0.15, 1.0], colors=['black'], alpha=0.9)
    ax.plot([0.75, 1.75, 1.75, 0.75, 0.75], [0.25, 0.25, 0.75, 0.75, 0.25], 'r--', lw=1.5)
    
    ax.set_title(f"TO-PINN Epoch: {epoch} | Solid Volume Target: 20%")
    ax.set_xlim(0, 3.0)
    ax.set_ylim(0, 1.0)
    ax.set_aspect('equal')
    
    filename = f"frames/epoch_{epoch:05d}.png"
    plt.savefig(filename, dpi=150, bbox_inches='tight')
    plt.close(fig)
    return filename


# Separate optimizers for stability
optimizer_flow = torch.optim.Adam(flow_net.parameters(), lr=1e-3)
optimizer_geo = torch.optim.Adam(geo_net.parameters(), lr=1e-3)

epochs = 8000
V_target = 0.20
frame_filenames = []

print("Starting Seamless Two-Phase Optimization...")

for epoch in range(epochs):
    pts, inflow, outflow, walls = sample_points()
    
    is_sculpting_phase = epoch > 1500
    lambda_max = 10000 if epoch > 500 else 100
    
    # 1. GENERATE THE TARGET BOUNDARIES
    in_design_x = torch.logical_and(pts[:, 0:1] >= 0.75, pts[:, 0:1] <= 1.75)
    in_design_y = torch.logical_and(pts[:, 1:2] >= 0.25, pts[:, 1:2] <= 0.75)
    in_design = torch.logical_and(in_design_x, in_design_y).float()
    
    # The physical block we force during Warmup
    forced_block = torch.logical_and(
        torch.logical_and(pts[:, 0:1] >= 1.0, pts[:, 0:1] <= 1.5),
        torch.logical_and(pts[:, 1:2] >= 0.35, pts[:, 1:2] <= 0.65)
    ).float()
    
    # 2. NEURAL NETWORK PREDICTIONS
    alpha_pred = geo_net(pts)
    uvp = flow_net(pts)
    u, v, p = uvp[:, 0:1], uvp[:, 1:2], uvp[:, 2:3]
    
    # 3. SEAMLESS PHASE TRANSITION
    alpha_active = alpha_pred if is_sculpting_phase else forced_block
    
    # 4. PHYSICS DIFFERENTIALS (Computed cleanly in-loop)
    u_grads = compute_gradients(u, pts)
    v_grads = compute_gradients(v, pts)
    p_grads = compute_gradients(p, pts)
    
    u_x, u_y = u_grads[:, 0:1], u_grads[:, 1:2]
    v_x, v_y = v_grads[:, 0:1], v_grads[:, 1:2]
    p_x, p_y = p_grads[:, 0:1], p_grads[:, 1:2]
    
    u_xx = compute_gradients(u_x, pts)[:, 0:1]
    u_yy = compute_gradients(u_y, pts)[:, 1:2]
    v_xx = compute_gradients(v_x, pts)[:, 0:1]
    v_yy = compute_gradients(v_y, pts)[:, 1:2]
    
    brinkman = lambda_max * (alpha_active * in_design)
    
    res_u = (u * u_x + v * u_y) + p_x - (1/30) * (u_xx + u_yy) + brinkman * u
    res_v = (u * v_x + v * v_y) + p_y - (1/30) * (v_xx + v_yy) + brinkman * v
    res_mass = u_x + v_y
    
    L_PDE = torch.mean(res_u**2 + res_v**2 + res_mass**2)
    L_Dissipation = torch.mean((1/30) * (2*u_x**2 + 2*v_y**2 + (u_y + v_x)**2) + brinkman * (u**2 + v**2))
    
    # 5. BOUNDARY CONDITIONS
    in_uvp, out_uvp, wall_uvp = flow_net(inflow), flow_net(outflow), flow_net(walls)
    L_BC_in = torch.mean((in_uvp[:, 0:1] - 1.0)**2 + (in_uvp[:, 1:2])**2)
    L_BC_out = torch.mean(out_uvp[:, 2:3]**2)
    wall_v_grads = compute_gradients(wall_uvp[:, 0:1], walls)[:, 1:2]
    L_BC_wall = torch.mean(wall_uvp[:, 1:2]**2 + wall_v_grads**2)
    L_BC = L_BC_in + L_BC_out + L_BC_wall
    
    # 6. OPTIMIZATION LOGIC
    optimizer_flow.zero_grad()
    optimizer_geo.zero_grad()
    
    if not is_sculpting_phase:
        # FlowNet learns the PDE. GeoNet MEMORIZES the block.
        loss_flow = L_PDE + 10.0 * L_BC
        loss_geo = torch.mean((alpha_pred - forced_block)**2) 
        loss_total = loss_flow + 1000.0 * loss_geo
        
        current_volume = torch.mean(forced_block)
    else:
        # Training wheels off. Both networks couple and sculpt.
        current_volume = torch.sum(alpha_active * in_design) / (torch.sum(in_design) + 1e-8)
        L_Vol = 50000.0 * (current_volume - V_target)**2
        L_Bin = 10.0 * torch.sum(4 * alpha_active * (1 - alpha_active) * in_design) / (torch.sum(in_design) + 1e-8)
        
        # NEW: The "Clean Workspace" Penalty
        # Punishes the AI with massive loss if it draws anything outside the red box
        L_Outside = 10000.0 * torch.mean((alpha_pred * (1 - in_design))**2)
        
        loss_total = L_PDE + 10.0*L_BC + L_Vol + 0.1*L_Dissipation + L_Bin + L_Outside
        
    loss_total.backward()
    optimizer_flow.step()
    optimizer_geo.step()
        
    # 7. VISUALIZATION
    if epoch % 200 == 0:
        phase = "Warmup" if not is_sculpting_phase else "Sculpting"
        print(f"Epoch {epoch:04d} [{phase}] | Loss: {loss_total.item():.4f} | Vol: {current_volume.item():.3f}")
        
        # We now safely pass geo_net because it has memorized the shape
        filename = save_frame(epoch, flow_net, geo_net)
        frame_filenames.append(filename)

print("Training complete. Generating GIF...")
with imageio.get_writer('airfoil_sculpting.gif', mode='I', duration=0.1) as writer:
    for filename in frame_filenames:
        image = imageio.imread(filename)
        writer.append_data(image)
